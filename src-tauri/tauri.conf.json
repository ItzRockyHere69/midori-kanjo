{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Midori Kanjo",
  "version": "0.1.1",
  "identifier": "com.sayanfinance.midorikanjo",
  "build": {
    "beforeDevCommand": "npm run tauri:frontend:dev",
    "beforeBuildCommand": "npm run mobile:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../mobile-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Midori Kanjo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss:; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "publisher": "Sayan Finance",
    "category": "Finance",
    "shortDescription": "Offline-first billing and inventory software",
    "longDescription": "Midori Kanjo is an offline-first wholesale billing, party, inventory and reporting app made by Sayan Finance.",
    "copyright": "Copyright © 2026 Sayan Finance",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
