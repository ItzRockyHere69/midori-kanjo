{
  "name": "midori-kanjo",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "mobile:build": "node scripts/mobile-build-verified.mjs",
    "mobile:assets": "node scripts/generate-android-assets.mjs",
    "mobile:sync": "node scripts/mobile-build-verified.mjs --sync",
    "mobile:android:debug": "npm run mobile:sync && node scripts/run-android-gradle.mjs assembleDebug",
    "mobile:android:bundle": "npm run mobile:sync && node scripts/run-android-gradle.mjs bundleRelease",
    "tauri": "tauri",
    "tauri:frontend:dev": "vite --config vite.mobile.config.ts --host 127.0.0.1 --port 1420 --strictPort",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:e2e:frontend": "vite build --config vite.mobile.config.ts --mode desktop-e2e",
    "tauri:e2e:build": "npm run tauri:e2e:frontend && cargo build --manifest-path src-tauri/Cargo.toml --release --features desktop-e2e",
    "test:tauri:e2e": "node scripts/require-desktop-e2e-env.mjs && wdio run wdio.tauri.conf.mjs",
    "test:tauri:config": "npm run mobile:build && node --test tests/tauri-package.test.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:platform",
    "test:unit": "esbuild tests/billing-core.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/billing-core.test.mjs && node --test .test-dist/billing-core.test.mjs",
    "test:mobile": "npm run mobile:sync && node --test tests/mobile-package.test.mjs",
    "test:desktop": "npm run mobile:build && node --test tests/desktop-package.test.mjs",
    "test:platform": "node --test tests/platform-hardening.test.mjs tests/native-platform-hardening.test.mjs tests/supabase-schema.test.mjs tests/dashboard-decoration.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern mobile-dist --ignore-pattern android/app/src/main/assets/public --ignore-pattern android/app/build --ignore-pattern outputs --ignore-pattern work --ignore-pattern .next --ignore-pattern .test-dist",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@supabase/supabase-js": "^2.112.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^1.1.7",
    "drizzle-orm": "0.45.2",
    "jspdf": "^4.2.1",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@cloudflare/vite-plugin": "1.51.1",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@wdio/cli": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/tauri-service": "^1.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.5",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "webdriverio": "^9.30.1",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.1.0"
    }
  },
  "type": "module",
  "displayName": "Midori Kanjo"
}
